.vscode/settings.json

# Secrets and local environment
.env
.venv/
*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Large / regenerated artefacts (rebuild with the pipeline)
data/raw/*
data/interim/*
data/processed/*
!data/*/.gitkeep
!data/README.md
!data/sample/
models/*
!models/README.md

# Interactive HTML figures are regenerated by the pipeline (PNG versions are tracked)
reports/figures/*.html
