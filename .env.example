# Copy to .env (make setup does this for you). .env is git-ignored - never commit real secrets.

# --- Database (PostgreSQL + PostGIS in Docker) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# Host port mapped to the container's 5432 (5432 is often used by a local Postgres).
DB_PORT=5434
DB_URL=postgresql+psycopg://postgres:postgres@localhost:5434/postgres

# --- Google Earth Engine (run `earthengine authenticate` once, then set your Cloud project) ---
GEE_PROJECT=

# --- Twilio (advisory delivery, Phase 9). Leave blank: DRY_RUN=true never sends anything. ---
DRY_RUN=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Advisory bot / delivery (Phase 9) ---
# Public URL Twilio calls (e.g. your ngrok address). Needed behind a tunnel or proxy so the webhook signature validates.
PUBLIC_BASE_URL=
# Local testing only: accept webhook calls without a Twilio signature. Never enable on a public server.
ALLOW_UNSIGNED_WEBHOOK=false
# Date used when a chat message names none (YYYY-MM-DD). Default: the last day of the observed weather record.
ADVISORY_AS_OF=
# Optional salt for the hashed opt-out list.
OPTOUT_SALT=
